-- ================= FILE SAVING & LOADING =================
local function LoadCatalogFromFile()
    if readfile and isfile and isfile(SAVE_FILE_NAME) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
        end)
        if success and type(result) == "table" then
            catalogData = result.data or {}
            catalogMessageId = result.messageId or nil
        end
    end
end

local function SaveCatalogToFile()
    if writefile then
        pcall(function()
            local payload = {
                data = catalogData,
                messageId = catalogMessageId
            }
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(payload))
        end)
    end
end
LoadCatalogFromFile()

local function CleanText(rawText)
    if not rawText then return "" end
    local clean = string.gsub(rawText, "<[^>]- >", "")
    clean = string.gsub(clean, "<[^>]+>", "")
    clean = string.gsub(clean, "%s+", " ")
    return string.match(clean, "^%s*(.-)%s*$") or ""
end

local function GetEffectivePrice(rawPriceText)
    local cleaned = CleanText(rawPriceText)
    if cleaned == "" then return "N/A" end
    
    local parts = {}
    for part in string.gmatch(cleaned, "%S+") do
        table.insert(parts, part)
    end
    
    if #parts > 0 then
        return parts[#parts]
    end
    return cleaned
end

local function ParsePriceToNumber(rawPriceText, isGold)
    local effectiveText = GetEffectivePrice(rawPriceText)
    if not effectiveText or effectiveText == "N/A" then return nil end
    local upperText = string.upper(effectiveText)
    
    local cleanNumStr = string.gsub(upperText, ",", "")
    local numString = string.match(cleanNumStr, "[%d%.]+")
    if not numString then return nil end
    local num = tonumber(numString)
    if not num then return nil end

    if not isGold then
        if string.find(upperText, "T") or string.find(upperText, "TRILLION") then
            return num * 1e12
        elseif string.find(upperText, "B") or string.find(upperText, "BILLION") then
            return num * 1e9
        elseif string.find(upperText, "M") or string.find(upperText, "MILLION") then
            return num * 1e6
        elseif string.find(upperText, "K") or string.find(upperText, "THOUSAND") then
            return num * 1e3
        end
    end

    return num
end

local function FetchImageUrl(rawImageId)
    if not rawImageId or rawImageId == "" then return nil end
    local assetId = string.match(tostring(rawImageId), "%d+")
    if not assetId then return nil end
    return "https://www.roblox.com/asset-thumbnail/image?assetId=" .. assetId .. "&width=420&height=420&format=png"
end

local function GetCatalogRarityDetails(typeText, isGold)
    local upperText = string.upper(typeText)
    
    if string.find(upperText, "FORBIDDEN") then
        return true, "FORBIDDEN"
    elseif string.find(upperText, "SECRET") and not isGold then
        return true, "SECRET"
    end
    
    return false, ""
end

local function IsGoldItem(itemFrame, rawPriceText)
    local upperRaw = string.upper(rawPriceText or "")
    if string.find(upperRaw, "GOLD") or string.find(upperRaw, "BAR") then
        return true
    end

    for _, desc in ipairs(itemFrame:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local txt = string.upper(desc.Text or "")
            if string.find(txt, "GOLD BAR") or string.find(txt, "GOLD COIN") then
                return true
            end
        end
    end
    return false
end

local function GetRarityDetails(typeText, isGold)
    local upperText = string.upper(typeText)
    
    -- If it's explicitly a gold item, ignore alerts as per configuration
    if isGold then
        return nil, "", false, nil
    end

    if string.find(upperText, "SECRET") then
        return COLOR_CYAN, "SECRET", true, ROLE_PING_SECRET        
    elseif string.find(upperText, "MYTHIC") then
        return COLOR_PINK_RED, "MYTHIC", true, ROLE_PING_MYTHIC    
    end

    return nil, "", false, nil
end

local function UpdateCatalogMessage()
    local descriptionLines = { "```ansi" }
    local forbiddenItems = {}
    local secretItems = {}

    for itemName, data in pairs(catalogData) do
        if data.category == "FORBIDDEN" then
            table.insert(forbiddenItems, { name = itemName, data = data })
        elseif data.category == "SECRET" then
            table.insert(secretItems, { name = itemName, data = data })
        end
    end

    table.insert(descriptionLines, "\27[31m[ 🔴 FORBIDDEN ITEMS (Gold Bars) ]\27[0m")
    table.insert(descriptionLines, string.format("%-22s %s", "Item", "Price Range"))
    table.insert(descriptionLines, string.rep("-", 38))
    
    if #forbiddenItems == 0 then
        table.insert(descriptionLines, "No recorded Forbidden items yet.")
    else
        for _, item in ipairs(forbiddenItems) do
            local rangeStr = (item.data.minStr == item.data.maxStr) and item.data.minStr or (item.data.minStr .. " - " .. item.data.maxStr)
            table.insert(descriptionLines, string.format("%-22s %s", item.name, rangeStr))
        end
    end

    table.insert(descriptionLines, "")

    table.insert(descriptionLines, "\27[36m[ 🔵 SECRET ITEMS (Cash) ]\27[0m")
    table.insert(descriptionLines, string.format("%-22s %s", "Item", "Price Range"))
    table.insert(descriptionLines, string.rep("-", 38))
    
    if #secretItems == 0 then
        table.insert(descriptionLines, "No recorded Secret items yet.")
    else
        for _, item in ipairs(secretItems) do
            local rangeStr = (item.data.minStr == item.data.maxStr) and item.data.minStr or (item.data.minStr .. " - " .. item.data.maxStr)
            table.insert(descriptionLines, string.format("%-22s %s", item.name, rangeStr))
        end
    end

    table.insert(descriptionLines, "```")

    local embedContent = table.concat(descriptionLines, "\n")
    local payload = {
        ["username"] = CATALOG_BOT_NAME,
        ["embeds"] = {
            {
                ["title"] = "📊 Market Price Range Catalog",
                ["description"] = embedContent,
                ["color"] = 3447003,
                ["footer"] = { ["text"] = CATALOG_BOT_NAME .. " • Price Range" },
                ["timestamp"] = DateTime.now():ToIsoDate()
            }
        }
    }

    pcall(function()
        if not catalogMessageId then
            local response = httpRequest({
                Url = WEBHOOK_URL .. "?wait=true",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(payload)
            })
            if response and response.Body then
                local decoded = HttpService:JSONDecode(response.Body)
                if decoded and decoded.id then
                    catalogMessageId = decoded.id
                    SaveCatalogToFile()
                end
            end
        else
            httpRequest({
                Url = WEBHOOK_URL .. "/messages/" .. catalogMessageId,
                Method = "PATCH",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(payload)
            })
        end
    end)
end

local function ScanShopAndNotify()
    local mafiaUI = LOCAL_PLAYER.PlayerGui:FindFirstChild("MafiaWarsUI")
    if not mafiaUI then return end

    local shopPanel = mafiaUI:FindFirstChild("Root") 
        and mafiaUI.Root:FindFirstChild("Content") 
        and mafiaUI.Root.Content:FindFirstChild("ShopPanel")
    if not shopPanel then return end

    local cashScroller = shopPanel:FindFirstChild("CashScroller")
    if not cashScroller then return end

    local currentlyVisible = {}
    local catalogUpdated = false

    for _, itemFrame in ipairs(cashScroller:GetChildren()) do
        if itemFrame:IsA("GuiObject") and string.match(itemFrame.Name, "^Shop_") and itemFrame.Visible then
            currentlyVisible[itemFrame.Name] = true

            local typeLabel = itemFrame:FindFirstChild("ItemText", true) or itemFrame:FindFirstChild("TypeText", true)
            local rawTypeText = typeLabel and typeLabel.Text or ""
            local cleanedType = CleanText(rawTypeText)

            local priceLabel = itemFrame:FindFirstChild("PriceText", true)
            local rawPriceText = priceLabel and priceLabel.Text or ""
            local priceText = GetEffectivePrice(rawPriceText)

            local isGold = IsGoldItem(itemFrame, rawPriceText)
            local nameLabel = itemFrame:FindFirstChild("ItemName", true)
            local itemName = nameLabel and CleanText(nameLabel.Text) or itemFrame.Name

            local catalogPriceStr = priceText
            if isGold then
                local cleanDigits = string.gsub(priceText, "[^%d%.]", "")
                if cleanDigits ~= "" then
                    catalogPriceStr = cleanDigits
                end
            end

            -- CATALOG LOGIC
            local recordInCatalog, catType = GetCatalogRarityDetails(cleanedType, isGold)
            if recordInCatalog then
                local numericVal = ParsePriceToNumber(rawPriceText, isGold)
                if numericVal then
                    if not catalogData[itemName] then
                        catalogData[itemName] = {
                            min = numericVal,
                            max = numericVal,
                            minStr = catalogPriceStr,
                            maxStr = catalogPriceStr,
                            category = catType
                        }
                        catalogUpdated = true
                    else
                        if numericVal < catalogData[itemName].min then
                            catalogData[itemName].min = numericVal
                            catalogData[itemName].minStr = catalogPriceStr
                            catalogUpdated = true
                        end
                        if numericVal > catalogData[itemName].max then
                            catalogData[itemName].max = numericVal
                            catalogData[itemName].maxStr = catalogPriceStr
                            catalogUpdated = true
                        end
                    end
                end
            end

            -- ALERT NOTIFICATIONS
            local color, rarityName, isTargetRarity, rolePing = GetRarityDetails(cleanedType, isGold)

            if isTargetRarity then
                if not notifiedItems[itemFrame.Name] then
                    local statLabel = itemFrame:FindFirstChild("StatText", true)
                    local numericPrice = ParsePriceToNumber(rawPriceText, isGold)
                    
                    if rarityName == "SECRET" and numericPrice and numericPrice < 1.5e12 then
                        rolePing = ROLE_PING_SECRET .. " " .. ROLE_PING_SECRET_UNDER_1_5T
                    end

                    local statText = statLabel and CleanText(statLabel.Text) or "None"
                    local imageUrl = CUSTOM_IMAGE_URLS[itemName]
                    
                    if not imageUrl then
                        local iconPlate = itemFrame:FindFirstChild("IconPlate", true)
                        local itemIcon = iconPlate and (iconPlate:FindFirstChild("ItemIcon", true) or iconPlate:FindFirstChildOfClass("ImageLabel"))
                        local rawImageId = itemIcon and itemIcon.Image or ""
                        imageUrl = FetchImageUrl(rawImageId)
                    end

                    local embedData = {
                        ["title"] = "🔥 " .. itemName,
                        ["color"] = color,
                        ["fields"] = {
                            { ["name"] = "✨ Rarity", ["value"] = rarityName, ["inline"] = true },
                            { ["name"] = "💰 Price", ["value"] = priceText, ["inline"] = true },
                            { ["name"] = "⚔️ Stats", ["value"] = statText, ["inline"] = false },
                            { ["name"] = "📦 Type", ["value"] = string.upper(cleanedType), ["inline"] = false }
                        },
                        ["footer"] = { ["text"] = ITEM_BOT_NAME },
                        ["timestamp"] = DateTime.now():ToIsoDate()
                    }

                    if imageUrl then
                        embedData["thumbnail"] = { ["url"] = imageUrl }
                    end

                    local payloadData = {
                        ["username"] = ITEM_BOT_NAME,
                        ["embeds"] = { embedData }
                    }

                    if rolePing and rolePing ~= "" then
                        payloadData["content"] = rolePing
                    end

                    pcall(function()
                        httpRequest({
                            Url = WEBHOOK_URL,
                            Method = "POST",
                            Headers = { ["Content-Type"] = "application/json" },
                            Body = HttpService:JSONEncode(payloadData)
                        })
                    end)

                    notifiedItems[itemFrame.Name] = true
                    task.wait(0.5) 
                end
            end
        end
    end

    if catalogUpdated then
        SaveCatalogToFile()
        UpdateCatalogMessage()
    end

    for cachedName, _ in pairs(notifiedItems) do
        if not currentlyVisible[cachedName] then
            notifiedItems[cachedName] = nil
        end
    end
end

task.spawn(function()
    print("[" .. ITEM_BOT_NAME .. "] Active! Watching CashScroller & Persistent Catalog...")
    pcall(UpdateCatalogMessage)
    while true do
        pcall(ScanShopAndNotify)
        task.wait(SCAN_INTERVAL)
    end
end)
