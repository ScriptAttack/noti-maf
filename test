local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

-- ================= CONFIGURATION =================
local WEBHOOK_URL = "https://discord.com/api/webhooks/1549486969220890737/2RYHoKo77nt1lsbGnaddqJtqWgfbllssylfSsUzxNKdNyCyyvtsKIBHT4zUA5Mkx_d-s"
local DISCORD_ROLE_OR_USER_PING = "" -- e.g. "<@&ROLE_ID>" or "@everyone"
local SCAN_INTERVAL = 5 -- Check every 5 seconds

local COLOR_CYAN = 65535         -- Cyan (#00FFFF) for Secret
local COLOR_PINK_RED = 13323087   -- Dark Pinkish-Red (#CB2C4F) for Mythic
-- =================================================

local LOCAL_PLAYER = Players.LocalPlayer
local httpRequest = request or http_request or (syn and syn.request) or (http and http.request)
local notifiedItems = {} -- Prevents duplicate webhooks for the same shop cycle

-- Strips XML/HTML/RichText tags and trims whitespace
local function CleanText(rawText)
    if not rawText then return "" end
    local clean = string.gsub(rawText, "<[^>]- >", "")
    clean = string.gsub(clean, "<[^>]+>", "")
    clean = string.gsub(clean, "%s+", " ")
    return string.match(clean, "^%s*(.-)%s*$") or ""
end

-- Multi-fallback thumbnail extractor for Discord compatibility
local function FetchImageUrl(rawImageId)
    if not rawImageId or rawImageId == "" then return nil end
    local assetId = string.match(to_string and to_string(rawImageId) or tostring(rawImageId), "%d+")
    if not assetId then return nil end

    -- Strategy 1: Try Roblox Official Thumbnails Batch API
    local apiUrl = "https://thumbnails.roblox.com/v1/assets?assetIds=" .. assetId .. "&size=420x420&format=Png&isCircular=false"
    local success, response = pcall(function()
        return httpRequest({ Url = apiUrl, Method = "GET" })
    end)

    if success and response and response.StatusCode == 200 then
        local decodeSuccess, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if decodeSuccess and data and data.data and data.data[1] and data.data[1].imageUrl then
            return data.data[1].imageUrl
        end
    end

    -- Strategy 2: Directly resolve using Roblox Asset Endpoint
    return "https://assetgame.roblox.com/Game/Tools/ThumbnailAsset.ashx?aid=" .. assetId .. "&fmt=png&wd=420&ht=420"
end

-- Evaluates rarity and assigns embed color
local function GetRarityDetails(typeText)
    local upperText = string.upper(typeText)
    if string.find(upperText, "SECRET") then
        return COLOR_CYAN, "SECRET", true
    elseif string.find(upperText, "MYTHIC") then
        return COLOR_PINK_RED, "MYTHIC", true
    end
    return nil, "", false
end

-- Main Shop Scanner
local function ScanShopAndNotify()
    local mafiaUI = LOCAL_PLAYER.PlayerGui:FindFirstChild("MafiaWarsUI")
    if not mafiaUI then return end

    local shopPanel = mafiaUI:FindFirstChild("Root") 
        and mafiaUI.Root:FindFirstChild("Content") 
        and mafiaUI.Root.Content:FindFirstChild("ShopPanel")
    if not shopPanel then return end

    local cashScroller = shopPanel:FindFirstChild("CashScroller")
    if not cashScroller then return end

    local currentlyVisible = {}

    for _, itemFrame in ipairs(cashScroller:GetChildren()) do
        if itemFrame:IsA("GuiObject") and string.match(itemFrame.Name, "^Shop_") and itemFrame.Visible then
            currentlyVisible[itemFrame.Name] = true

            local typeLabel = itemFrame:FindFirstChild("ItemText", true) or itemFrame:FindFirstChild("TypeText", true)
            local rawTypeText = typeLabel and typeLabel.Text or ""
            local cleanedType = CleanText(rawTypeText)

            local color, rarityName, isTargetRarity = GetRarityDetails(cleanedType)

            if isTargetRarity then
                if not notifiedItems[itemFrame.Name] then
                    local priceLabel = itemFrame:FindFirstChild("PriceText", true)
                    local statLabel = itemFrame:FindFirstChild("StatText", true)
                    local nameLabel = itemFrame:FindFirstChild("ItemName", true)

                    local priceText = priceLabel and CleanText(priceLabel.Text) or "N/A"
                    local statText = statLabel and CleanText(statLabel.Text) or "None"
                    local itemName = nameLabel and CleanText(nameLabel.Text) or itemFrame.Name

                    -- Icon Extraction Across Multiple Common UI Layouts
                    local rawImageId = ""
                    local iconPlate = itemFrame:FindFirstChild("IconPlate", true) or itemFrame:FindFirstChild("Icon", true)
                    
                    if iconPlate then
                        local itemIcon = iconPlate:FindFirstChild("ItemIcon", true) or iconPlate:FindFirstChildOfClass("ImageLabel")
                        if itemIcon then
                            rawImageId = itemIcon.Image
                        end
                    else
                        local imgObj = itemFrame:FindFirstChildOfClass("ImageLabel", true)
                        if imgObj then
                            rawImageId = imgObj.Image
                        end
                    end

                    local imageUrl = FetchImageUrl(rawImageId)

                    local embedData = {
                        ["title"] = "🔥 " .. itemName,
                        ["color"] = color,
                        ["fields"] = {
                            { ["name"] = "✨ Rarity", ["value"] = rarityName, ["inline"] = true },
                            { ["name"] = "💰 Price", ["value"] = priceText, ["inline"] = true },
                            { ["name"] = "⚔️ Stats", ["value"] = statText, ["inline"] = false },
                            { ["name"] = "📦 Type", ["value"] = string.upper(cleanedType), ["inline"] = false }
                        },
                        ["footer"] = { ["text"] = "Mafia Wars High-Rarity Tracker" },
                        ["timestamp"] = DateTime.now():ToIsoDate()
                    }

                    -- Only insert thumbnail if a valid URL was returned
                    if imageUrl and imageUrl ~= "" then
                        embedData["thumbnail"] = { ["url"] = imageUrl }
                    end

                    local payloadData = {
                        ["username"] = "Shop Tracker",
                        ["embeds"] = { embedData }
                    }

                    if DISCORD_ROLE_OR_USER_PING ~= "" then
                        payloadData["content"] = DISCORD_ROLE_OR_USER_PING
                    end

                    pcall(function()
                        httpRequest({
                            Url = WEBHOOK_URL,
                            Method = "POST",
                            Headers = { ["Content-Type"] = "application/json" },
                            Body = HttpService:JSONEncode(payloadData)
                        })
                    end)

                    notifiedItems[itemFrame.Name] = true
                    task.wait(0.5) -- Prevent Discord rate limiting
                end
            end
        end
    end

    -- Clear cache for items that disappear so future rotations notify again
    for cachedName, _ in pairs(notifiedItems) do
        if not currentlyVisible[cachedName] then
            notifiedItems[cachedName] = nil
        end
    end
end

-- Continuous background loop
task.spawn(function()
    print("[Shop Tracker] Running scanner loop...")
    while true do
        pcall(ScanShopAndNotify)
        task.wait(SCAN_INTERVAL)
    end
end)
