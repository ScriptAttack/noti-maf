-- Strips XML/HTML tags and trims whitespace
local function CleanText(rawText)
    if not rawText then return "" end
    local clean = string.gsub(rawText, "<[^>]- >", "")
    clean = string.gsub(clean, "<[^>]+>", "")
    clean = string.gsub(clean, "%s+", " ")
    return string.match(clean, "^%s*(.-)%s*$") or ""
end

-- Extracts only the final price to pay (if there's a discount showing old and new price side-by-side)
local function GetActivePrice(rawPriceText)
    local cleaned = CleanText(rawPriceText)
    if cleaned == "" then return "N/A" end
    
    -- Find all price chunks matching currency patterns (e.g. $610M, $2.21T, etc.)
    local prices = {}
    for match in string.gmatch(cleaned, "%$?[%d%.]+[TBKM%a]*") do
        table.insert(prices, match)
    end
    
    if #prices > 0 then
        -- Return the last item in the list, which is the active/discounted price on the right side
        return prices[#prices]
    end
    
    return cleaned
end

-- Converts formatted currency strings (e.g. "$1.2T", "800B", "1.5 Trillion") to raw numbers
local function ParsePriceToNumber(rawPriceText)
    local activePriceText = GetActivePrice(rawPriceText)
    if not activePriceText or activePriceText == "" then return nil end
    local upperText = string.upper(activePriceText)
    
    local numString = string.match(upperText, "[%d%.]+")
    if not numString then return nil end
    local num = tonumber(numString)
    if not num then return nil end

    if string.find(upperText, "T") or string.find(upperText, "TRILLION") then
        return num * 1e12
    elseif string.find(upperText, "B") or string.find(upperText, "BILLION") then
        return num * 1e9
    elseif string.find(upperText, "M") or string.find(upperText, "MILLION") then
        return num * 1e6
    elseif string.find(upperText, "K") or string.find(upperText, "THOUSAND") then
        return num * 1e3
    end

    return num
end

-- Converts any asset ID / rbxassetid string directly into a clean Discord-compatible image URL
local function FetchImageUrl(rawImageId)
    if not rawImageId or rawImageId == "" then return nil end
    local assetId = string.match(tostring(rawImageId), "%d+")
    if not assetId then return nil end

    return "https://www.roblox.com/asset-thumbnail/image?assetId=" .. assetId .. "&width=420&height=420&format=png"
end

-- Checks rarity type and returns matching embed color, raw rarity string, alert status, and default role ping
local function GetRarityDetails(typeText)
    local upperText = string.upper(typeText)
    if string.find(upperText, "FORBIDDEN") then
        return COLOR_CRIMSON, "FORBIDDEN", true, nil              
    elseif string.find(upperText, "SECRET") then
        return COLOR_CYAN, "SECRET", true, ROLE_PING_SECRET       
    elseif string.find(upperText, "MYTHIC") then
        return COLOR_PINK_RED, "MYTHIC", true, ROLE_PING_MYTHIC   
    end
    return nil, "", false, nil
end

-- Checks if an item frame or price string indicates a Gold Bar currency item
local function IsGoldItem(itemFrame, rawPriceText)
    local upperRaw = string.upper(rawPriceText or "")
    if string.find(upperRaw, "GOLD") or string.find(upperRaw, "BAR") then
        return true
    end

    for _, desc in ipairs(itemFrame:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local txt = string.upper(desc.Text or "")
            if string.find(txt, "GOLD") or string.find(txt, "BAR") then
                return true
            end
        end
    end

    return false
end

-- Main function to scan the shop
local function ScanShopAndNotify()
    local mafiaUI = LOCAL_PLAYER.PlayerGui:FindFirstChild("MafiaWarsUI")
    if not mafiaUI then return end

    local shopPanel = mafiaUI:FindFirstChild("Root") 
        and mafiaUI.Root:FindFirstChild("Content") 
        and mafiaUI.Root.Content:FindFirstChild("ShopPanel")
    if not shopPanel then return end

    local cashScroller = shopPanel:FindFirstChild("CashScroller")
    if not cashScroller then return end

    local currentlyVisible = {}

    for _, itemFrame in ipairs(cashScroller:GetChildren()) do
        if itemFrame:IsA("GuiObject") and string.match(itemFrame.Name, "^Shop_") and itemFrame.Visible then
            currentlyVisible[itemFrame.Name] = true

            local typeLabel = itemFrame:FindFirstChild("ItemText", true) or itemFrame:FindFirstChild("TypeText", true)
            local rawTypeText = typeLabel and typeLabel.Text or ""
            local cleanedType = CleanText(rawTypeText)

            local color, rarityName, isTargetRarity, rolePing = GetRarityDetails(cleanedType)

            if isTargetRarity then
                if not notifiedItems[itemFrame.Name] then
                    local priceLabel = itemFrame:FindFirstChild("PriceText", true)
                    local rawPriceText = priceLabel and priceLabel.Text or ""

                    if IsGoldItem(itemFrame, rawPriceText) then
                        notifiedItems[itemFrame.Name] = true
                    else
                        local statLabel = itemFrame:FindFirstChild("StatText", true)
                        local nameLabel = itemFrame:FindFirstChild("ItemName", true)

                        local priceText = GetActivePrice(rawPriceText)

                        local numericPrice = ParsePriceToNumber(rawPriceText)
                        if rarityName == "SECRET" and numericPrice and numericPrice < 1.5e12 then
                            rolePing = ROLE_PING_SECRET .. " " .. ROLE_PING_SECRET_UNDER_1_5T
                        end

                        local statText = statLabel and CleanText(statLabel.Text) or "None"
                        local itemName = nameLabel and CleanText(nameLabel.Text) or itemFrame.Name

                        -- Check if there's a custom image override for this specific item name, otherwise fetch default
                        local imageUrl = CUSTOM_IMAGE_URLS[itemName]
                        if not imageUrl then
                            local iconPlate = itemFrame:FindFirstChild("IconPlate", true)
                            local itemIcon = iconPlate and (iconPlate:FindFirstChild("ItemIcon", true) or iconPlate:FindFirstChildOfClass("ImageLabel"))
                            local rawImageId = itemIcon and itemIcon.Image or ""
                            imageUrl = FetchImageUrl(rawImageId)
                        end

                        local embedData = {
                            ["title"] = "🔥 " .. itemName,
                            ["color"] = color,
                            ["fields"] = {
                                { ["name"] = "✨ Rarity", ["value"] = rarityName, ["inline"] = true },
                                { ["name"] = "💰 Price", ["value"] = priceText, ["inline"] = true },
                                { ["name"] = "⚔️ Stats", ["value"] = statText, ["inline"] = false },
                                { ["name"] = "📦 Type", ["value"] = string.upper(cleanedType), ["inline"] = false }
                            },
                            ["footer"] = { ["text"] = BOT_NAME },
                            ["timestamp"] = DateTime.now():ToIsoDate()
                        }

                        if imageUrl then
                            embedData["thumbnail"] = { ["url"] = imageUrl }
                        end

                        local payloadData = {
                            ["username"] = BOT_NAME,
                            ["embeds"] = { embedData }
                        }

                        -- Attach custom avatar URL if defined
                        if BOT_AVATAR_URL and BOT_AVATAR_URL ~= "" then
                            payloadData["avatar_url"] = BOT_AVATAR_URL
                        end

                        if rolePing and rolePing ~= "" then
                            payloadData["content"] = rolePing
                        end

                        pcall(function()
                            httpRequest({
                                Url = WEBHOOK_URL,
                                Method = "POST",
                                Headers = { ["Content-Type"] = "application/json" },
                                Body = HttpService:JSONEncode(payloadData)
                            })
                        end)

                        notifiedItems[itemFrame.Name] = true
                        task.wait(0.5) 
                    end
                end
            end
        end
    end

    for cachedName, _ in pairs(notifiedItems) do
        if not currentlyVisible[cachedName] then
            notifiedItems[cachedName] = nil
        end
    end
end

-- Continuous background thread
task.spawn(function()
